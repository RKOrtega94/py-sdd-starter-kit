# Py-SDD-Starter-Kit - Variables de Entorno de Ejemplo
# ------------------------------
# NUNCA commits de valores reales ni secretos.
# Copiar este archivo a `.env` y completar solo en desarrollo local.
# Para producción usar un gestor de secretos (AWS Secrets Manager,
# HashiCorp Vault, Azure Key Vault).

# ------------------------------
# Configuración de Modelos / RAG
# ------------------------------
# Endpoint del modelo de lenguaje
MODEL_ENDPOINT=http://localhost:8000/v1
# Endpoint de embeddings
EMBEDDING_ENDPOINT=http://localhost:8001/embed
# Dimensión de los vectores (768 para local, 2048 para remote/exact)
EMBEDDING_DIM=768
# Umbral de similitud para recuperación (0.0 - 1.0)
SIMILARITY_THRESHOLD=0.7
# Proveedor de vectores LOCAL | REDIS | SUPABASE | PINECONE | QDRANT
VECTOR_PROVIDER=local

# ------------------------------
# Configuración de Base de Datos / Vector Store
# ------------------------------
# URL de conexión Redis (si usa Redis como vector store)
REDIS_URL=redis://localhost:6379
# Connection string Supabase (si usa Supabase Postgres + Vector extension)
SUPABASE_URL=https://xyz.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# Configuración Pinecone
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=your-pinecone-environment
# Configuración Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-api-key

# ------------------------------
# Seguridad y Concurrencia
# ------------------------------
# Clave secreta para firmado de JWT (usar un gestor de secretos en producción)
SECRET_KEY=change-this-with-a-proper-random-value
# Tiempo de expiración de tokens (en minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Límite de concurrencia paralelo de solicitudes
CONCURRENCY_LIMIT=10

# ------------------------------
# Aplicación
# ------------------------------
# Nombre de la aplicación
APP_NAME=py-sdd-starter-kit
# Entorno (development | staging | production)
APP_ENV=development
# Puerto del servidor (si tiene entry point HTTP/CLI)
APP_PORT=8000